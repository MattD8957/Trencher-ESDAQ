#include <cmath>
#include <iostream>

// Motor Control Command Template

// Hardware Limits (adjust if needed later)
#define MAX_RPM        14
#define MIN_RPM        0

// Voltage constants
#define VOLTAGE_MAX    5.0
#define VOLTAGE_MIN    0.0

// Pin definitions
#define PIN_DIRECTION  DIO0
#define PIN_ENABLE     DIO1
#define PIN_SPEED      DIO2
#define PIN_BRAKE      DIO3

void digitalWrite(int pin, int value) { } 
void analogWrite(int pin, float value) { }

// Function: SetMotorTargetRPM
void SetMotorTargetRPM(int targetRPM)
{
    // ----------------------------
    // 1. Clamp RPM to valid range
    // ----------------------------
    int clampedRPM = targetRPM;

    if (targetRPM > MAX_RPM)
    {
        // TODO: set to MAX_RPM
        clampledRPM = MAX_RPM;
    }
    else if (targetRPM < MIN_RPM)
    {
        // TODO: set to MIN_RPM
        clampledRPM = MIN_RPM;
    }

    // -----------------------------------------
    // 2. Determine Direction (sign of target)
    // -----------------------------------------
    bool directionCW;

    if (clampedRPM >= 0)
    {
        //CW logic
        directionCW = true;
    }
    else
    {
        //CCW logic
        directionCW = false;
    }

    // -----------------------------------------
    // 3. Convert RPM magnitude to 0–5V scale
    // -----------------------------------------
    float rpmMagnitude = abs(clampedRPM);

    float speedVoltage = (rpmMagnitude / MAX_RPM) * (VOLTAGE_MAX - VOLTAGE_MIN) + VOLTAGE_MIN;  // Map RPM to 0–5V

    // -----------------------------------------
    // 4. Safety Checks
    // -----------------------------------------

    bool brakeIsOff = Run;
    bool enableIsOn = Disable;

    if (!brakeIsOff || !enableIsOn)
    {
        // - Set speed to 0V
        analogWrite(PIN_SPEED, 0);  // Ensure motor is stopped
        // - Prompt UI (placeholder call)
        printf("Error: Brake is engaged or Enable is off. Motor cannot run.\n");
        // - Exit function
        return;
    }

    // -----------------------------------------
    // 5. Apply Outputs
    // -----------------------------------------

    // Direction Pin (0V CW, 5V CCW)
    if (directionCW)
    {
        // Write 0V to direction pin
        digitalWrite(PIN_DIRECTION, false);
    }
    else
    {
        // Write 5V to direction pin
        digitalWrite(PIN_DIRECTION, true);
    }

    // Enable Pin (0V Enable, 5V Disable)
    digitalWrite(PIN_ENABLE, false);
    // TODO: Ensure enable is correct state

    // Speed Pin (0–5V analog output)
    analogWrite(PIN_SPEED, speedVoltage);
    // TODO: Write speedVoltage to speed pin
}
